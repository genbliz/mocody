{
  "compilerOptions": {
    "target": "es2024",
    "module": "es2022",
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "alwaysStrict": true,
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src/",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/dumps/**", "src/test/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
